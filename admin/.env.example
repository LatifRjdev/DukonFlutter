# Public URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4455/api

# Internal URL the Next.js server uses to reach the API from route
# handlers — used by /api/auth/login. Optional; falls back to
# NEXT_PUBLIC_API_URL when unset. Useful when the admin panel and
# API are co-located behind different hostnames (e.g. inside Docker).
API_INTERNAL_URL=

# JWT access secret — must match api/.env JWT_ACCESS_SECRET so the
# middleware can verify tokens issued by the API.
JWT_ACCESS_SECRET=

# Sentry — frontend error reporting. Public DSN (in JS bundle at runtime).
NEXT_PUBLIC_SENTRY_DSN=https://badaaed08382cdd7fde67eb93f5bb394@o4511295919095808.ingest.de.sentry.io/4511295927877712
