NODE_ENV=development
PORT=4455

# Database
DATABASE_URL=postgresql://user:password@localhost:5435/dukonpro

# Redis
REDIS_URL=redis://localhost:6380

# JWT — MUST be rotated for production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-64-byte-hex-string
JWT_REFRESH_SECRET=change-me-64-byte-hex-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-here
# Secret token registered with Telegram's setWebhook(secret_token=...).
# Required in production — the webhook endpoint rejects all requests at
# boot time if this is unset while NODE_ENV=production, since an unset
# secret means anyone can POST forged Telegram Update payloads.
TELEGRAM_WEBHOOK_SECRET=

# CORS — set to your frontend domain in production
# Leave empty for development (allows localhost)
CORS_ORIGIN=
PORT=4455

DATABASE_URL=postgresql://dukonpro:dukonpro_secret@localhost:5435/dukonpro
REDIS_URL=redis://localhost:6380

# JWT secrets — DO NOT copy these placeholder strings into a real .env.
# Generate a unique 64-byte hex per environment:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Or run:
#   bash scripts/setup-env.sh
# The backend refuses to start if these are unset or if JWT_ACCESS_SECRET
# equals JWT_REFRESH_SECRET (enforced at boot).
JWT_ACCESS_SECRET=__REPLACE_WITH_RANDOM_64_BYTE_HEX__
JWT_REFRESH_SECRET=__REPLACE_WITH_RANDOM_64_BYTE_HEX__
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# CORS — comma-separated list of allowed origins. Fail-fast in production if
# unset. In development the server defaults to http://localhost:* when unset.
CORS_ORIGIN=

# ── Sprint 3: Integrations ──────────────────────────────────────────────────

# Telegram Bot (Sprint 3)
# Create a bot via @BotFather on Telegram and paste the token here.
# If unset, the Telegram module starts in no-op mode (no errors).
TELEGRAM_BOT_TOKEN=

# Firebase Cloud Messaging (Sprint 3)
# Paste the full JSON content of your Firebase service account key as a single
# line (or set via environment — do NOT commit the real key to source control).
# If unset, push notifications are saved to DB only; FCM delivery is skipped.
FIREBASE_SERVICE_ACCOUNT=

# Sentry — error reporting / performance.
# Required in production. In development, leaving this empty disables init.
SENTRY_DSN=https://1cb6c561eae05fa51a22505da527045d@o4511295919095808.ingest.de.sentry.io/4511296168722512
