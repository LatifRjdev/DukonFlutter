generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USERS & AUTH ============

model User {
  id              String    @id @default(uuid())
  phone           String    @unique
  password        String
  name            String
  email           String?
  avatar          String?
  isActive        Boolean   @default(true)
  isAdmin         Boolean   @default(false)
  // F.1: bumped on password change (or admin-forced logout). JWT
  // strategies reject any access token whose `iat` predates this
  // timestamp, so a leaked token is invalidated as soon as the
  // user (or admin) rotates the password.
  tokensRevokedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownedStores   Store[]        @relation("StoreOwner")
  staffRoles    Staff[]
  refreshTokens RefreshToken[]
  fcmTokens     FcmToken[]
  notifications Notification[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ============ STORES ============

model Store {
  id        String        @id @default(uuid())
  ownerId   String
  owner     User          @relation("StoreOwner", fields: [ownerId], references: [id])
  name      String
  category  StoreCategory
  currency  Currency      @default(TJS)
  address   String?
  phone     String?
  logoUrl   String?
  settings  Json          @default("{}")
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  subscription     Subscription?
  products         Product[]
  categories       Category[]
  sales            Sale[]
  expenses         Expense[]
  customers        Customer[]
  suppliers        Supplier[]
  staff            Staff[]
  shifts           Shift[]
  inventories      Inventory[]
  syncLogs         SyncLog[]
  zakatSettings    ZakatSettings?
  zakatPayments    ZakatPayment[]
  supplierPayments SupplierPayment[]
  rolePermissions  RolePermission[]
  payrollPeriods   PayrollPeriod[]
  deliveries       Delivery[]
  inventoryCounts  InventoryCount[]
  notifications    Notification[]
  discounts        Discount[]
  investments         Investment[]
  loyaltyTransactions LoyaltyTransaction[]

  @@map("stores")
}

enum StoreCategory {
  GROCERY
  CLOTHING
  ELECTRONICS
  HARDWARE
  PHARMACY
  OTHER
}

enum Currency {
  TJS
  USD
  RUB
}

// ============ SUBSCRIPTIONS ============

model Subscription {
  id                 String             @id @default(uuid())
  storeId            String             @unique
  store              Store              @relation(fields: [storeId], references: [id])
  plan               SubscriptionPlan
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  adminDiscount      Decimal?           @db.Decimal(5, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payments Payment[]

  @@map("subscriptions")
}

enum SubscriptionPlan {
  START
  BUSINESS
  PREMIUM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Payment {
  id              String        @id @default(uuid())
  subscriptionId  String
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  currency        Currency
  method          PaymentMethod
  status          PaymentStatus
  transactionId   String?
  receiptImage    String?
  // F2.5: original request note (e.g. "Plan change request to BUSINESS")
  // and rejection reason now live in separate columns. Previously both
  // shared `note`, so rejecting overwrote the requested-plan audit
  // trail.
  note            String?
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime      @default(now())

  @@map("payments")
}

enum PaymentMethod {
  CARD
  MOBILE_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  FAILED
  REFUNDED
}

model SubscriptionPlanConfig {
  plan           SubscriptionPlan @id
  price          Decimal          @db.Decimal(12, 2)
  maxProducts    Int
  maxStaff       Int
  maxDiscounts   Int
  hasReportsAll  Boolean
  hasExport      Boolean
  hasTelegram    Boolean
  hasAllPush     Boolean
  hasDelivery    Boolean
  hasInventory   Boolean
  hasZakat       Boolean          @default(false)
  hasInvestments Boolean          @default(false)
  hasLoyalty     Boolean          @default(false)

  @@map("subscription_plan_configs")
}

// ============ PRODUCTS ============

model Category {
  id        String     @id @default(uuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id])
  name      String
  icon      String?
  color     String?
  sortOrder Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([storeId, name])
  @@map("categories")
}

model Product {
  id             String      @id @default(uuid())
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id])
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id])
  supplierId     String?
  supplier       Supplier?   @relation(fields: [supplierId], references: [id])
  name           String
  sku            String?
  barcode        String?
  description    String?
  costPrice      Decimal?    @db.Decimal(12, 2)
  sellPrice      Decimal     @db.Decimal(12, 2)
  wholesalePrice Decimal?    @db.Decimal(12, 2)
  quantity       Int         @default(0)
  minQuantity    Int         @default(0)
  unit           ProductUnit @default(PCS)
  imageUrl       String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  saleItems           SaleItem[]
  stockMovements      StockMovement[]
  inventoryItems      InventoryItem[]
  inventoryCountItems InventoryCountItem[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([storeId, name])
  @@map("products")
}

enum ProductUnit {
  PCS
  KG
  L
  M
  PACK
}

model StockMovement {
  id         String       @id @default(uuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  type       MovementType
  quantity   Int
  unitCost   Decimal?     @db.Decimal(12, 2)
  totalCost  Decimal?     @db.Decimal(12, 2)
  supplierId String?
  reference  String?
  notes      String?
  createdBy  String?
  createdAt  DateTime     @default(now())
  // Spec B E.2: client-supplied UUID for offline-replay idempotency.
  // Globally unique because clients generate v4 UUIDs and we don't
  // need to scope dedup per-store (StockMovement has no storeId column;
  // it scopes through product).
  localId    String?      @unique

  @@index([productId, createdAt])
  @@map("stock_movements")
}

enum MovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER
  WRITE_OFF
}

// ============ SALES ============

model Sale {
  id           String          @id @default(uuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id])
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id])
  staffId      String?
  staff        Staff?          @relation(fields: [staffId], references: [id])
  shiftId      String?
  shift        Shift?          @relation(fields: [shiftId], references: [id])
  receiptNo    String
  subtotal     Decimal         @db.Decimal(12, 2)
  discount     Decimal         @default(0) @db.Decimal(12, 2)
  discountType DiscountType?
  total        Decimal         @db.Decimal(12, 2)
  paymentType  SalePaymentType
  paidAmount   Decimal         @db.Decimal(12, 2)
  change       Decimal         @default(0) @db.Decimal(12, 2)
  debtAmount   Decimal         @default(0) @db.Decimal(12, 2)
  dueDate      DateTime?
  status       SaleStatus      @default(COMPLETED)
  notes        String?
  localId      String?
  syncedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  items               SaleItem[]
  debtPayments        DebtPayment[]
  delivery            Delivery?
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([storeId, receiptNo])
  @@index([storeId, createdAt])
  @@index([customerId])
  @@map("sales")
}

enum SalePaymentType {
  CASH
  CARD
  DEBT
  MIXED
  LOYALTY_POINTS
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum SaleStatus {
  COMPLETED
  RETURNED
  PARTIALLY_RETURNED
  CANCELLED
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  costPrice   Decimal? @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)

  @@map("sale_items")
}

model DebtPayment {
  id        String          @id @default(uuid())
  saleId    String
  sale      Sale            @relation(fields: [saleId], references: [id])
  amount    Decimal         @db.Decimal(12, 2)
  method    SalePaymentType
  notes     String?
  // E.3: client-supplied UUID for offline-replay idempotency.
  localId   String?
  createdAt DateTime        @default(now())

  @@unique([saleId, localId])
  @@map("debt_payments")
}

// ============ CUSTOMERS ============

model Customer {
  id             String    @id @default(uuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id])
  name           String
  phone          String?
  email          String?
  birthday       DateTime?
  notes          String?
  loyaltyPoints  Int       @default(0)
  totalSpent     Decimal   @default(0) @db.Decimal(12, 2)
  debt           Decimal   @default(0) @db.Decimal(12, 2)
  isActive       Boolean   @default(true)
  telegramChatId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sales               Sale[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([storeId, phone])
  @@map("customers")
}

// ============ SUPPLIERS ============

model Supplier {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  debt      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products         Product[]
  supplierPayments SupplierPayment[]

  @@map("suppliers")
}

// ============ STAFF ============

model Staff {
  id         String    @id @default(uuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  role       StaffRole
  salary     Decimal?  @db.Decimal(12, 2)
  commission Decimal?  @db.Decimal(5, 2)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  sales      Sale[]
  shifts     Shift[]
  payrolls   Payroll[]
  deliveries Delivery[]

  @@unique([storeId, userId])
  @@map("staff")
}

enum StaffRole {
  OWNER
  ADMIN
  CASHIER
  WAREHOUSE
}

model Shift {
  id              String      @id @default(uuid())
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id])
  staffId         String
  staff           Staff       @relation(fields: [staffId], references: [id])
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  openingCash     Decimal     @db.Decimal(12, 2)
  closingCash     Decimal?    @db.Decimal(12, 2)
  expectedCash    Decimal?    @db.Decimal(12, 2)
  difference      Decimal?    @db.Decimal(12, 2)
  salesTotal      Decimal     @default(0) @db.Decimal(12, 2)
  salesCount      Int         @default(0)
  cashSales       Decimal     @default(0) @db.Decimal(12, 2)
  cardSales       Decimal     @default(0) @db.Decimal(12, 2)
  debtSales       Decimal     @default(0) @db.Decimal(12, 2)
  returnsTotal    Decimal     @default(0) @db.Decimal(12, 2)
  returnsCount    Int         @default(0)
  cashWithdrawals Decimal     @default(0) @db.Decimal(12, 2)
  status          ShiftStatus @default(OPEN)
  notes           String?
  // E.1: client-supplied UUID for offline-replay idempotency.
  localId         String?

  sales Sale[]

  @@map("shifts")
}

enum ShiftStatus {
  OPEN
  CLOSED
}

// ============ FINANCES ============

model Expense {
  id           String          @id @default(uuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id])
  category     ExpenseCategory
  amount       Decimal         @db.Decimal(12, 2)
  description  String?
  notes        String?
  receiptUrl   String?
  isRecurring  Boolean         @default(false)
  recurringDay Int?
  createdBy    String?
  date         DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([storeId, date])
  @@map("expenses")
}

enum ExpenseCategory {
  PURCHASE
  RENT
  SALARY
  UTILITIES
  TRANSPORT
  MARKETING
  OTHER
}

model ExchangeRate {
  id           String   @id @default(uuid())
  storeId      String
  fromCurrency Currency
  toCurrency   Currency
  rate         Decimal  @db.Decimal(12, 6)
  date         DateTime @default(now())

  @@map("exchange_rates")
}

// ============ ZAKAT ============

model ZakatSettings {
  id            String    @id @default(uuid())
  storeId       String    @unique
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nisabGold     Decimal   @default(85) @db.Decimal(12, 2)
  nisabSilver   Decimal   @default(595) @db.Decimal(12, 2)
  nisabCurrency Currency  @default(TJS)
  nisabAmount   Decimal   @default(0) @db.Decimal(12, 2)
  haulStartDate DateTime?
  zakatRate     Decimal   @default(2.5) @db.Decimal(5, 2)
  // Spec E: merchant-supplied cash on hand. Calculated into
  // totalAssets when includeCash=true. Default 0 so existing
  // rows continue to compute correctly until merchant fills in.
  cashOnHand    Decimal   @default(0) @db.Decimal(12, 2)
  includeStock  Boolean   @default(true)
  includeCash   Boolean   @default(true)
  includeDebts  Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("zakat_settings")
}

model ZakatPayment {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  totalAssets Decimal  @db.Decimal(12, 2)
  zakatDue    Decimal  @db.Decimal(12, 2)
  breakdown   Json
  notes       String?
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())
  // Z-P1-1: client-supplied UUID for idempotent retries. Scoped per
  // store so two stores can independently send the same client UUID
  // without collision (e.g. clients that reset their UUID seed on
  // re-install). Existing rows keep `localId = NULL` and are exempt
  // from the unique constraint via Postgres' default NULL semantics.
  localId     String?

  @@unique([storeId, localId])
  @@index([storeId, paidAt])
  @@map("zakat_payments")
}

model SupplierPayment {
  id         String          @id @default(uuid())
  storeId    String
  store      Store           @relation(fields: [storeId], references: [id])
  supplierId String
  supplier   Supplier        @relation(fields: [supplierId], references: [id])
  amount     Decimal         @db.Decimal(12, 2)
  method     SalePaymentType
  notes      String?
  createdAt  DateTime        @default(now())
  // Spec B E.3: client-supplied UUID for offline-replay idempotency.
  localId    String?

  @@unique([storeId, localId])
  @@index([supplierId, createdAt])
  @@map("supplier_payments")
}

// ============ INVENTORY ============

model Inventory {
  id          String          @id @default(uuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id])
  categoryId  String?
  status      InventoryStatus @default(IN_PROGRESS)
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  notes       String?

  items InventoryItem[]

  @@map("inventories")
}

enum InventoryStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model InventoryItem {
  id          String    @id @default(uuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  systemQty   Int
  actualQty   Int?
  difference  Int?

  @@map("inventory_items")
}

// ============ LOYALTY ============

model LoyaltySettings {
  id               String   @id @default(uuid())
  storeId          String   @unique
  isEnabled        Boolean  @default(false)
  pointsPerAmount  Int      @default(1)
  amountForPoints  Decimal  @db.Decimal(12, 2)
  pointValue       Decimal  @db.Decimal(12, 4)
  welcomePoints    Int      @default(0)
  birthdayDiscount Decimal? @db.Decimal(5, 2)
  pointsExpireDays Int?

  @@map("loyalty_settings")
}

model LoyaltyTransaction {
  id           String        @id @default(uuid())
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type         LoyaltyTxType
  points       Int
  saleId       String?
  sale         Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  expiresAt    DateTime?
  sourceEarnId String?
  note         String?
  createdAt    DateTime      @default(now())

  @@index([customerId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("loyalty_transactions")
}

model Promotion {
  id          String        @id @default(uuid())
  storeId     String
  name        String
  type        PromotionType
  value       Decimal       @db.Decimal(12, 2)
  minPurchase Decimal?      @db.Decimal(12, 2)
  categoryId  String?
  productId   String?
  promoCode   String?
  usageLimit  Int?
  usedCount   Int           @default(0)
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean       @default(true)

  @@map("promotions")
}

enum PromotionType {
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
  BUY_X_GET_Y
  HAPPY_HOURS
}

// ============ DISCOUNTS ============

model Discount {
  id         String    @id @default(uuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  name       String
  type       String // FIXED, PERCENTAGE
  value      Float
  condition  String // CART, CATEGORY, PRODUCT
  categoryId String?
  productId  String?
  minTotal   Float?
  startDate  DateTime
  endDate    DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([storeId])
  @@map("discounts")
}

// ============ NOTIFICATIONS ============

model TelegramBot {
  id       String   @id @default(uuid())
  storeId  String   @unique
  chatId   String
  isActive Boolean  @default(true)
  settings Json     @default("{}")
  linkedAt DateTime @default(now())

  @@map("telegram_bots")
}

// ============ RBAC ============

model RolePermission {
  id         String    @id @default(uuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  role       StaffRole
  permission String
  isGranted  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([storeId, role, permission])
  @@map("role_permissions")
}

// ============ PAYROLL ============

model PayrollPeriod {
  id          String        @id @default(uuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id])
  month       Int
  year        Int
  status      PayrollStatus @default(DRAFT)
  totalAmount Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount  Decimal       @default(0) @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payrolls Payroll[]

  @@unique([storeId, month, year])
  @@map("payroll_periods")
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  PARTIALLY_PAID
  PAID
}

model Payroll {
  id              String        @id @default(uuid())
  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  staffId         String
  staff           Staff         @relation(fields: [staffId], references: [id])
  baseSalary      Decimal       @db.Decimal(12, 2)
  commission      Decimal       @default(0) @db.Decimal(12, 2)
  commissionRate  Decimal?      @db.Decimal(5, 2)
  salesTotal      Decimal       @default(0) @db.Decimal(12, 2)
  shiftsWorked    Int           @default(0)
  shiftsExpected  Int           @default(26)
  totalAmount     Decimal       @db.Decimal(12, 2)
  isPaid          Boolean       @default(false)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  adjustments PayrollAdjustment[]

  @@unique([payrollPeriodId, staffId])
  @@map("payrolls")
}

model PayrollAdjustment {
  id          String         @id @default(uuid())
  payrollId   String
  payroll     Payroll        @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  type        AdjustmentType
  amount      Decimal        @db.Decimal(12, 2)
  description String
  date        DateTime?
  createdAt   DateTime       @default(now())

  @@map("payroll_adjustments")
}

enum AdjustmentType {
  BONUS
  DEDUCTION
}

// ============ SYNC ============

model SyncLog {
  id          String     @id @default(uuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id])
  deviceId    String
  operation   String
  entityType  String
  entityId    String
  payload     Json
  status      SyncStatus
  localId     String?
  createdAt   DateTime   @default(now())
  processedAt DateTime?

  @@index([storeId, createdAt])
  @@map("sync_logs")
}

enum SyncStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CONFLICT
}

// ============ DELIVERIES ============

model Delivery {
  id        String         @id @default(uuid())
  storeId   String
  store     Store          @relation(fields: [storeId], references: [id])
  saleId    String         @unique
  sale      Sale           @relation(fields: [saleId], references: [id])
  address   String
  courierId String?
  courier   Staff?         @relation(fields: [courierId], references: [id])
  status    DeliveryStatus @default(NEW)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([storeId])
  @@index([status])
  @@map("deliveries")
}

enum DeliveryStatus {
  NEW
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

// ============ INVENTORY COUNTS ============

model InventoryCount {
  id          String               @id @default(uuid())
  storeId     String
  store       Store                @relation(fields: [storeId], references: [id])
  status      InventoryCountStatus @default(IN_PROGRESS)
  createdAt   DateTime             @default(now())
  completedAt DateTime?
  items       InventoryCountItem[]

  @@index([storeId])
  @@map("inventory_counts")
}

enum InventoryCountStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model InventoryCountItem {
  id               String         @id @default(uuid())
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  expectedQty      Float
  actualQty        Float?

  @@index([inventoryCountId])
  @@map("inventory_count_items")
}

// ============ ADMIN ============

model Announcement {
  id             String              @id @default(uuid())
  title          String
  body           String
  targetPlan     SubscriptionPlan?
  targetStatus   SubscriptionStatus?
  sentBy         String
  recipientCount Int
  createdAt      DateTime            @default(now())

  @@map("announcements")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============ CURRENCY RATES ============

model CurrencyRate {
  id        String   @id @default(uuid())
  currency  String // USD, RUB, EUR, CNY
  buyRate   Float
  sellRate  Float
  nbtRate   Float
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([currency, date])
  @@index([date])
  @@map("currency_rates")
}

// ============ FCM TOKENS ============

model FcmToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String // ANDROID, IOS
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("fcm_tokens")
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // LOW_STOCK, NEW_SALE, SHIFT_CLOSED, DELIVERY_COMPLETED, DEBT_REMINDER
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([storeId, userId])
  @@index([createdAt])
  @@map("notifications")
}

// ============ OTP CODES ============

enum OtpType {
  VERIFY
  RESET
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  type      OtpType
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, type])
  @@map("otp_codes")
}

// ============ INVESTMENTS ============

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LoyaltyTxType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

model Investment {
  id            String           @id @default(uuid())
  storeId       String
  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  amount        Decimal          @db.Decimal(12, 2)
  returnAmount  Decimal?         @db.Decimal(12, 2)
  investorName  String
  investorPhone String?
  status        InvestmentStatus @default(ACTIVE)
  startDate     DateTime
  endDate       DateTime?
  // Spec D: client-supplied UUID for offline-replay idempotency.
  // Per-store unique because clients may reset UUIDs on re-install.
  localId       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([storeId, localId])
  @@index([storeId])
  @@index([status])
  @@index([storeId, createdAt(sort: Desc)])
  @@map("investments")
}
